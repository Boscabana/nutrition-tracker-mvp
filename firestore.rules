rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Does the request UID match the document UID?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow any logged-in user to READ basic profile (needed for household names)
      // but only the owner can WRITE.
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Rules for all subcollections under a user (diary, weight, etc.)
      // These REMAIN private to the owner only!
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Rules for the 'households' collection
    match /households/{householdId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.members);
      allow write: if isAuthenticated() && (request.auth.uid == resource.data.adminUid || request.auth.uid in resource.data.members);
      allow create: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }
  }
}
