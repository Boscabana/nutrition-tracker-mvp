<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Erforderlich für Health Connect (Android 14+) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    
    <!-- Erforderlich für Health Connect (Legacy / APK Version) -->
    <uses-permission android:name="androidx.health.permission.Steps.READ" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application android:allowBackup="true" android:label="Nutrition MVP" android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- Health Connect Rationale Intent Filter -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            
            <!-- Erforderlich für die Integration in die System-Einstellungen -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!-- Registriert die Activity als offizielle Rationale-Activity -->
        <meta-data android:name="health_permissions_rationale" android:value=".MainActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nick.nutritiontracker.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
